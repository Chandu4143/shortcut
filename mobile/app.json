{
  "expo": {
    "name": "Short Cut",
    "slug": "short-cut",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "shortcut",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.shortcut.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Short Cut uses your location to snap the shortest route to where you are."
      }
    },
    "android": {
      "package": "app.shortcut.mobile",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "geo" }],
          "category": ["DEFAULT", "BROWSABLE"]
        },
        {
          "action": "VIEW",
          "data": [{ "scheme": "google.navigation" }],
          "category": ["DEFAULT", "BROWSABLE"]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundColor": "#F0F2E9",
        "monochromeImage": "./assets/icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "@maplibre/maplibre-react-native",
        {
          "android": {
            "locationEngine": "default"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Short Cut uses your location to snap the shortest route to where you are."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0F2E9",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-router"
    ]
  }
}
